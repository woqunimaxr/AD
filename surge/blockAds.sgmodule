# 回答详情页 - 评论区顶部、下一个回答
zhihu8 = type=http-response,pattern=(?i)^https://api\.zhihu\.com/next-(?:bff|data|render),script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhihu/zhihu.js,requires-body=true,argument="{\"vihu_enable\":{{{vihu_enable}}}}"
zhihu9 = type=http-response,pattern=(?i)^https://api\.zhihu\.com/questions/\d+(?:/answers|/feeds|\?include=),script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhihu/zhihu.js,requires-body=true,argument="{\"vihu_enable\":{{{vihu_enable}}}}"
zhihu10 = type=http-response,pattern=(?i)^https://www\.zhihu\.com/api/v4/(?:articles|answers)/\d+/recommendations?\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhihu/zhihu.js,requires-body=true,argument="{\"vihu_enable\":{{{vihu_enable}}}}"
# 其他 - 服务器推送配置
zhihu11 = type=http-response,pattern=(?i)^https://appcloud2\.zhihu\.com/v3/config,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhihu/zhihu.js,requires-body=true,argument="{\"vihu_enable\":{{{vihu_enable}}}}"
zhihu12 = type=http-response,pattern=(?i)^https://m-cloud\.zhihu\.com/api/cloud/config/all\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhihu/zhihu.js,requires-body=true,argument="{\"vihu_enable\":{{{vihu_enable}}}}"

# > 中国国际航空
# hostname = m.airchina.com.cn
airchina = type=http-response,pattern=(?i)^https://m\.airchina\.com\.cn/airchina/gateway/v\d(\.\d)*/api/services,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/airchina.js,timeout=60,argument="{\"vsgogojihhks_enable\":{{{vsgogojihhks_enable}}}}"

# > 转转
# hostname = app.zhuanzhuan.com
# “我的”页面去除冗余的模块
zhuanzhuan = type=http-response,pattern=(?i)^https?://app\.zhuanzhuan\.com/zz/transfer/getmyprofilev3,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhuanzhuan/zhuanzhuan.js,timeout=60,requires-body=true,argument="{\"vrvr_enable\":{{{vrvr_enable}}}}"


