adrive = type=http-response,pattern=(?i)^https://api\.alipan\.com/apps/v2/users/home/(news|widgets),script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/adrive/adrive.js,timeout=60,requires-body=true,argument="{\"alyp_enable\":{{{alyp_enable}}}}"
