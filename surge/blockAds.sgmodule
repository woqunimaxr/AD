bohe_ads = type=http-response,pattern=(?i)^https://api\.boohee\.com/meta-interface/v2/index\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/bohe/bohe_ads.js,timeout=60,requires-body=true,argument="{\"bohejmkh_enable\":{{{bohejmkh_enable}}}}"
