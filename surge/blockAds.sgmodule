bilibiliManga3 = type=http-response,pattern=(?i)^https?://manga\.bilibili\.com/twirp/comic\.v\d\.Home/HomeFeed,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliManga.js,timeout=60,requires-body=true,argument="{\"bilimanhua_enable\":{{{bilimanhua_enable}}}}"
