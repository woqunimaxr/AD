cnftp10 = type=http-response,pattern=(?i)^https?://iface2\.iqiyi\.com/fusion/3\.0/common_switch\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
