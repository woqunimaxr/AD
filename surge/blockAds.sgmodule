cnftp = type=http-response,pattern=(?i)^https?://[\d\.]+/3f1/cards\.iqiyi\.com/(views_home/3\.0/qy_home|waterfall/3\.0/feed)\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
cnftp2 = type=http-response,pattern=(?i)^https?://access\.if\.iqiyi\.com/3f1/cards\.iqiyi\.com/(views_category/3\.0/category_home|views_home/3\.0/qy_home|waterfall/3\.0/feed)\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
cnftp3 = type=http-response,pattern=(?i)^https?://cards\.iqiyi\.com/views_category/3\.0/(category_home|categorylib_content|film_hybrid)\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
cnftp4 = type=http-response,pattern=(?i)^https?://cards\.iqiyi\.com/(views_home/3\.0/qy_home|waterfall/3\.0/feed)\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
# 播放详情页
cnftp5 = type=http-response,pattern=(?i)^https?://cards\.iqiyi\.com/views_plt/3\.0/player_tabs_v2\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
# 搜索页列表
cnftp6 = type=http-response,pattern=(?i)^https?://cards\.iqiyi\.com/views_search/3\.0/(hot_query_)?search\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
# 评论区
cnftp7 = type=http-response,pattern=(?i)^https?://comment-card\.iqiyi\.com/views_comment/3\.0/long_video_comments\?,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js,timeout=60,requires-body=true,argument="{\"aiqiyi_enable\":{{{aiqiyi_enable}}}}"
# 我的页面菜单
