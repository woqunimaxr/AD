#!name=多App去开屏广告
#!desc=仅移除指定 App 的开屏广告：萤石云视频(api.ys7.com/api/ads)、Soul(ssp.soulapp.cn/api/q)。不影响其他功能，不处理信息流/弹窗等其他广告。需开启 MitM 并信任证书。后续新增 App 直接按区块追加即可。
#!openUrl=https://clashios.app/stoverride/lodepuly_vpn_tool/

# ============================================================
# [Mitm] 对所有开屏广告接口所在域名做解密（URL Rewrite 依赖此项）
#   新增 App 时，把对应域名追加到 hostname 列表
# ============================================================
[Mitm]
hostname = api.ys7.com, ssp.soulapp.cn

# ============================================================
# [URL Rewrite] 命中各 App 开屏广告接口时返回空/断开
#   新增 App 时，按区块追加一条规则即可
# ============================================================
[URL Rewrite]
# ---------- 萤石云视频 开屏广告 ----------
^https:\/\/api\.ys7\.com\/api\/ads reject

# ---------- Soul 开屏广告 ----------
^https:\/\/ssp\.soulapp\.cn\/api\/q reject-dict
